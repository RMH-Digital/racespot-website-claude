# Copy to .env.local for local work. Production values live in Coolify → Environment Variables.

# YouTube Data API v3 (server-only). LIVE key uses its own quota for live detection.
YOUTUBE_API_KEY=
YOUTUBE_LIVE_API_KEY=
YOUTUBE_CHANNEL_ID=UCyhYD5vb-N_0TJZMVegCVgw

# Google Sheets master schedule (server-only)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_API_KEY=

# Cloudflare Turnstile — contact form spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form delivery (server-only). Leave SMTP_USER/PASS empty → mailto fallback.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=contact@racespot.tv

# Umami analytics (self-hosted). Both empty → no tracking script is rendered.
NEXT_PUBLIC_UMAMI_SRC=https://stats.racespot.tv/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
